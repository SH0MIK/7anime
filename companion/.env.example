# 7Anime Desktop Presence Companion Configuration
# Discord Application ID obtained from the Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_application_id_here

# Local WebSocket Port (default: 17077)
COMPANION_PORT=17077

# Public Website Base URL for "Watch on 7Anime" button
PUBLIC_BASE_URL=https://7anime.to

# Optional: Specific additional allowed origin (e.g. for staging)
# ADDITIONAL_ALLOWED_ORIGIN=https://staging.7anime.to
