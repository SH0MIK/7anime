# 7Anime Backend Environment Variables Example
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# The Movie Database (TMDB) API Credentials
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# Upstash Redis Distributed Cache
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Supabase Auth & PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# SMTP Email Transport (Port 465 SSL or 587 STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=7Anime Security <your_email@gmail.com>

# Gmail Mailer — Existing Email Transport Client (Preserved original variables)
GOOGLE_CLIENT_ID=your_gmail_mailer_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_gmail_mailer_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Google Login — Dedicated User Authentication Client (Independent from Mailer)
GOOGLE_AUTH_CLIENT_ID=your_google_login_client_id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_SECRET=your_google_login_client_secret_here
GOOGLE_AUTH_REDIRECT_URI=https://sevenanime-new.onrender.com/api/auth/google/callback

# MyAnimeList Client Credentials (Official API v2 - https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
