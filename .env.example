# 7ANIME_NEW — Root Environment Template
# Backend runs on port 3001/5000; Frontend Vite runs on port 5173/4173

# Server Environment
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Frontend URLs (Optional for local dev; set to your production backend URL once deployed)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api
VITE_BACKEND_URL=http://localhost:3001

# Supabase (Project: 7anime_one)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Upstash Redis Cache
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Email SMTP Transport (Dual-Port: 465 SSL/TLS or 587 STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=7Anime Security <your_email@gmail.com>

# Google OAuth 2.0 Web Client
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Gmail API / OAuth (Separated from SMTP)
GMAIL_USER=your_email@gmail.com
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# Public Branding
PUBLIC_LOGO_URL=/logo.png

# TMDB (The Movie Database) Metadata
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# Official MyAnimeList API v2 (https://myanimelist.net/apiconfig)
MAL_CLIENT_ID=your_mal_client_id_here
MAL_CLIENT_SECRET=your_mal_client_secret_here
